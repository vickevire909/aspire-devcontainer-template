{
  "name": "Aspire Devcontainer Template",
  "forwardPorts": [18080],
  "portsAttributes": {
    "18080": {
      "label": "Scalar API Reference",
      "requireLocalPort": true
    }
  },
  "build": {
    "dockerfile": "Dockerfile.dev",
    "context": ".."
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=projectname-bashhistory,target=/commandhistory,type=volume",
    "source=${localEnv:HOME}/.codex,target=${localEnv:HOME}/.codex,type=bind"
  ],
  "runArgs": [
    "--name",
    "aspire-devcontainer-template",
    "--security-opt",
    "seccomp=unconfined" // Enable Codex sandbox
  ],
  "remoteEnv": {
    "CODEX_HOME": "${localEnv:HOME}/.codex",
    "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/usr/lib/ssl/certs",
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "postCreateCommand": {
    "Set bash history volume permissions": "sudo chown -R $(whoami): /commandhistory",
    "Restore .NET solution": "dotnet restore || true",
    "Restore .NET tools": "dotnet tool restore || true"
  },
  "postStartCommand": {
    "Install .NET dev certs": "dotnet dev-certs https --trust"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "enableNonRootDocker": true,
      "moby": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/microsoft/aspire-devcontainer-feature/aspire:3.1.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "microsoft-aspire.aspire-vscode",
        "csharpier.csharpier-vscode",
        "esbenp.prettier-vscode",
        "humao.rest-client",
        "github.vscode-pull-request-github"
      ],
      "terminal.integrated.inheritEnv": true
    }
  }
}
