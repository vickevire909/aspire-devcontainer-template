// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
    "name": "Aspire",
    "build": {
        "dockerfile": "Dockerfile.dev"
    },
    "features": {
        "ghcr.io/microsoft/aspire-devcontainer-feature/aspire:2": {},
        "ghcr.io/devcontainers/features/powershell:2.0.3": {},
        "ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/devcontainers-extra/features/uv:1": {},
        "ghcr.io/devcontainers/features/node:2.1.0": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
            "enableNonRootDocker": true,
            "moby": true
        },
        "ghcr.io/devcontainers/features/node:2": {},
        "ghcr.io/devcontainers/features/powershell:2": {}
    },
    "hostRequirements": {
        "cpus": 8,
        "memory": "32gb",
        "storage": "64gb"
    },
    // "forwardPorts": [5000, 5001],
    // "portsAttributes": {
    //		"5001": {
    //			"protocol": "https"
    //		}
    // }
    "postCreateCommand": {
        "dotnetRestore": "dotnet restore",
        "dotnetToolRestore": "dotnet tool restore"
    },
    "postStartCommand": {
        "devcerts": "dotnet dev-certs https --trust || true"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "microsoft-aspire.aspire-vscode",
                "csharpier.csharpier-vscode",
                "esbenp.prettier-vscode"
            ]
        }
    }
    // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
    // "remoteUser": "root"
}
